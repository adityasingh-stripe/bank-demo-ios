#!/bin/bash

set -euo pipefail

usage() {
  echo "Usage: ./scripts/select-brand <brand> [--check]" >&2
  echo "Available brands:" >&2
  find "$(cd "$(dirname "${BASH_SOURCE[0]}")/../Branding" 2>/dev/null && pwd)" \
    -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2>/dev/null | sort >&2 || true
  exit 64
}

[[ $# -ge 1 && $# -le 2 ]] || usage

brand_id="$1"
check_only=false
if [[ $# -eq 2 ]]; then
  [[ "$2" == "--check" ]] || usage
  check_only=true
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
brand_dir="$repo_root/Branding/$brand_id"
manifest="$brand_dir/brand.json"
logo="$brand_dir/logo.png"

[[ -f "$manifest" ]] || { echo "error: unknown brand '$brand_id'" >&2; usage; }
[[ -f "$logo" ]] || { echo "error: missing logo: $logo" >&2; exit 1; }
command -v jq >/dev/null || { echo "error: jq is required" >&2; exit 1; }
command -v swift >/dev/null || { echo "error: Swift is required" >&2; exit 1; }
command -v sips >/dev/null || { echo "error: sips is required" >&2; exit 1; }

manifest_id="$(jq -er '.id' "$manifest")"
swift_configuration="$(jq -er '.swiftConfiguration' "$manifest")"
primary_color="$(jq -er '.primaryColor' "$manifest")"
icon_background="$(jq -er '.appIcon.backgroundColor' "$manifest")"
icon_treatment="$(jq -er '.appIcon.logoTreatment' "$manifest")"
launch_background="$(jq -er '.launch.backgroundColor' "$manifest")"
launch_treatment="$(jq -er '.launch.logoTreatment' "$manifest")"

[[ "$manifest_id" == "$brand_id" ]] || { echo "error: manifest id does not match '$brand_id'" >&2; exit 1; }
[[ "$primary_color" =~ ^#[0-9A-Fa-f]{6}$ ]] || { echo "error: invalid primaryColor in $manifest" >&2; exit 1; }
[[ "$icon_background" =~ ^#[0-9A-Fa-f]{6}$ ]] || { echo "error: invalid app icon background in $manifest" >&2; exit 1; }
[[ "$launch_background" =~ ^#[0-9A-Fa-f]{6}$ ]] || { echo "error: invalid launch background in $manifest" >&2; exit 1; }
[[ "$icon_treatment" == "original" || "$icon_treatment" == "white" ]] || { echo "error: invalid app icon treatment in $manifest" >&2; exit 1; }
[[ "$launch_treatment" == "original" || "$launch_treatment" == "white" ]] || { echo "error: invalid launch treatment in $manifest" >&2; exit 1; }

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

cp "$logo" "$tmp_dir/SelectedBrandLogo.png"
swift "$script_dir/render-brand-assets.swift" \
  "$logo" "$icon_background" "$icon_treatment" \
  "$tmp_dir/AppIconWithAlpha.png" "$tmp_dir/AppIconLaunchLogo.png"
swift "$script_dir/render-brand-assets.swift" \
  "$logo" "$launch_background" "$launch_treatment" \
  "$tmp_dir/unused-icon.png" "$tmp_dir/SelectedLaunchLogo.png"
sips -s format jpeg -s formatOptions 100 \
  "$tmp_dir/AppIconWithAlpha.png" --out "$tmp_dir/AppIcon.jpg" >/dev/null
sips -s format png "$tmp_dir/AppIcon.jpg" --out "$tmp_dir/AppIcon.png" >/dev/null

icon_width="$(sips -g pixelWidth "$tmp_dir/AppIcon.png" | awk '/pixelWidth/ { print $2 }')"
icon_height="$(sips -g pixelHeight "$tmp_dir/AppIcon.png" | awk '/pixelHeight/ { print $2 }')"
icon_alpha="$(sips -g hasAlpha "$tmp_dir/AppIcon.png" | awk '/hasAlpha/ { print $2 }')"
[[ "$icon_width" == "1024" && "$icon_height" == "1024" ]] || {
  echo "error: generated app icon must be 1024x1024" >&2
  exit 1
}
[[ "$icon_alpha" == "no" ]] || {
  echo "error: generated app icon must be opaque" >&2
  exit 1
}

cat > "$tmp_dir/SelectedBankConfiguration.generated.swift" <<EOF
// Generated by ./scripts/select-brand $brand_id. Do not edit by hand.
extension BankConfiguration {
    static let current = BankConfiguration.$swift_configuration
}
EOF

rgb="${launch_background#\#}"
red=$((16#${rgb:0:2}))
green=$((16#${rgb:2:2}))
blue=$((16#${rgb:4:2}))
cat > "$tmp_dir/SelectedLaunchBackground.json" <<EOF
{
  "colors" : [
    {
      "color" : {
        "color-space" : "srgb",
        "components" : {
          "alpha" : "1.000",
          "blue" : "0x$(printf '%02X' "$blue")",
          "green" : "0x$(printf '%02X' "$green")",
          "red" : "0x$(printf '%02X' "$red")"
        }
      },
      "idiom" : "universal"
    }
  ],
  "info" : {
    "author" : "xcode",
    "version" : 1
  }
}
EOF

destinations=(
  "$repo_root/BankDemo/Assets.xcassets/AppIcon.appiconset/App_store_1024_1x.png:$tmp_dir/AppIcon.png"
  "$repo_root/BankDemo/Assets.xcassets/SelectedBrandLogo.imageset/SelectedBrandLogo.png:$tmp_dir/SelectedBrandLogo.png"
  "$repo_root/BankDemo/Assets.xcassets/SelectedLaunchLogo.imageset/SelectedLaunchLogo.png:$tmp_dir/SelectedLaunchLogo.png"
  "$repo_root/BankDemo/Assets.xcassets/SelectedLaunchBackground.colorset/Contents.json:$tmp_dir/SelectedLaunchBackground.json"
  "$repo_root/BankDemo/Configuration/SelectedBankConfiguration.generated.swift:$tmp_dir/SelectedBankConfiguration.generated.swift"
)

if $check_only; then
  stale=false
  for pair in "${destinations[@]}"; do
    destination="${pair%%:*}"
    generated="${pair#*:}"
    if [[ ! -f "$destination" ]] || ! cmp -s "$destination" "$generated"; then
      echo "stale: ${destination#"$repo_root/"}" >&2
      stale=true
    fi
  done
  $stale && exit 1
  echo "Brand '$brand_id' is selected and generated assets are current."
  exit 0
fi

for pair in "${destinations[@]}"; do
  destination="${pair%%:*}"
  generated="${pair#*:}"
  mkdir -p "$(dirname "$destination")"
  if [[ ! -f "$destination" ]] || ! cmp -s "$destination" "$generated"; then
    cp "$generated" "$destination"
  fi
done

echo "Selected brand '$brand_id'. Review and commit the generated changes."
